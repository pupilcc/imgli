# imgli B-③ 厂商矩阵凭据模板。
# 复制到 ~/.secrets/imgli-s3-vendors.env 并填真值;真值文件绝不入 repo。
# 每厂商一组,前缀区分;桶必须是专用测试桶(匿名不可读,presign A 段依赖)。
# ENDPOINT 参考值来自各厂商文档,实测为准(B-③ 的任务就是校正这张表)。

# 本地 MinIO(骨架自验/回归)
MINIO_ENDPOINT=http://127.0.0.1:19000
MINIO_REGION=us-east-1
MINIO_AK=b3admin
MINIO_SK=b3secret12
MINIO_BUCKET=b3-matrix
MINIO_PATHSTYLE=true
MINIO_PREFIX=matrix/

# 七牛 Kodo(S3 兼容端点;region 命名非 AWS 风格,待实测校正)
QINIU_ENDPOINT=s3.cn-east-1.qiniucs.com
QINIU_REGION=cn-east-1
QINIU_AK=
QINIU_SK=
QINIU_BUCKET=
QINIU_PATHSTYLE=false
QINIU_PREFIX=matrix/

# 腾讯 COS(bucket 名强制带 -APPID 后缀)
COS_ENDPOINT=cos.ap-guangzhou.myqcloud.com
COS_REGION=ap-guangzhou
COS_AK=
COS_SK=
COS_BUCKET=imgli-matrix-1250000000
COS_PATHSTYLE=false
COS_PREFIX=matrix/

# 阿里云 OSS(S3 兼容;UNSIGNED-PAYLOAD 支持待实测)
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_REGION=cn-hangzhou
OSS_AK=
OSS_SK=
OSS_BUCKET=
OSS_PATHSTYLE=false
OSS_PREFIX=matrix/

# 又拍云(2026-07-26 摸底:官方有 S3 兼容端点;凭据=控制台「操作员授权-S3访问凭证」;
# 「仅支持文件相关API」→ 测试桶(服务)须控制台预建;region 官方「不支持配置区域」,先填 us-east-1 待实测)
UPYUN_ENDPOINT=s3.api.upyun.com
UPYUN_REGION=us-east-1
UPYUN_AK=
UPYUN_SK=
UPYUN_BUCKET=
UPYUN_PATHSTYLE=false
UPYUN_PREFIX=matrix/

# Cloudflare R2 (S3 API tokens: AK/SK from dashboard)
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_REGION=auto
R2_AK=
R2_SK=
R2_BUCKET=imgli-presign-spike
R2_PATHSTYLE=false
R2_PREFIX=matrix/
